<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CEIP Julián Nieto Tapia | Inicio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --azul-cole: #004a99; --naranja-cole: #f39200; }
        .bg-azul { background-color: var(--azul-cole); }
        .text-azul { color: var(--azul-cole); }
        .hero-gradient { 
            background: linear-gradient(rgba(0,74,153,0.7), rgba(0,74,153,0.7)), url('https://images.unsplash.com/photo-1523050853064-dbad350c746b?auto=format&fit=crop&q=80'); 
            background-size: cover; 
            background-position: center;
        }
        #junita-btn {
            background-image: url('junita.png');
            background-size: cover;
            background-position: center;
            border: 3px solid white;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <nav class="bg-white shadow-md p-4 sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <img src="logo.png" alt="Logo Colegio" class="h-12 w-auto onerror="this.style.display='none'">
                <h1 class="text-xl font-bold text-azul hidden md:block uppercase tracking-tight">CEIP Julián Nieto Tapia</h1>
            </div>
            <div class="flex items-center gap-6 font-medium">
                <a href="#" class="hover:text-orange-500 transition">Inicio</a>
                <a href="#noticias" class="hover:text-orange-500 transition">Noticias</a>
                <button onclick="toggleAdmin()" class="bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded text-xs text-gray-500 transition">⚙️ Admin</button>
            </div>
        </div>
    </nav>

    <header class="hero-gradient h-[450px] flex items-center justify-center text-center text-white px-4">
        <div class="max-w-3xl">
            <h2 class="text-4xl md:text-6xl font-extrabold mb-4 uppercase tracking-wider drop-shadow-lg">Bienvenidos</h2>
            <p class="text-xl md:text-2xl font-light drop-shadow-md">Un espacio para aprender, crecer y soñar juntos.</p>
        </div>
    </header>

    <section id="noticias" class="py-16 container mx-auto px-4">
        <div class="flex items-center justify-between mb-12">
            <h3 class="text-3xl font-bold text-azul">Actualidad del Centro</h3>
            <div class="h-1 flex-grow mx-6 bg-orange-100 rounded hidden md:block"></div>
        </div>
        <div id="contenedor-noticias" class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center py-10">
            <p class="text-gray-400 italic col-span-full">Cargando noticias desde el servidor...</p>
        </div>
    </section>

    <div id="chat-junita" class="fixed bottom-6 right-6 z-[100]">
        <div id="burbuja-chat" class="hidden bg-white shadow-2xl rounded-2xl w-80 mb-4 overflow-hidden border border-gray-200 transform transition-all">
            <div class="bg-azul p-4 text-white flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-lg">🤖</div>
                    <span class="font-bold">Chat con Junita</span>
                </div>
                <button onclick="toggleChat()" class="text-white hover:rotate-90 transition-transform">✕</button>
            </div>
            <div id="mensajes-chat" class="h-80 p-4 overflow-y-auto text-sm bg-gray-50 space-y-3">
                <div class="bg-white p-3 rounded-lg shadow-sm border-l-4 border-orange-400">
                    ¡Hola! Soy <strong>Junita</strong>, tu asistente del colegio. ¿En qué puedo ayudarte?
                </div>
            </div>
            <div class="p-3 bg-white border-t flex gap-2">
                <input type="text" id="input-chat" placeholder="Escribe tu duda..." class="flex-grow p-2 text-sm bg-gray-100 rounded-lg outline-none focus:ring-2 focus:ring-orange-300">
                <button class="bg-azul text-white p-2 rounded-lg"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
        <button id="junita-btn" onclick="toggleChat()" class="hover:scale-110 active:scale-95 transition-all w-20 h-20 rounded-full shadow-2xl">
        </button>
    </div>

    <div id="panel-admin" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[200] hidden flex items-center justify-center p-4">
        <div class="bg-white p-8 rounded-3xl max-w-lg w-full shadow-2xl">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-azul italic">Panel de Control</h2>
                <button onclick="toggleAdmin()" class="text-gray-400 hover:text-red-500 text-2xl">×</button>
            </div>
            <p class="text-sm text-gray-500 mb-6 font-semibold uppercase tracking-widest">Publicar Noticia o Circular</p>
            <input type="text" id="titulo-noticia" placeholder="Título de la noticia" class="w-full border-2 border-gray-100 p-3 mb-4 rounded-xl focus:border-orange-400 outline-none">
            <textarea id="texto-noticia" placeholder="Contenido de la noticia..." class="w-full border-2 border-gray-100 p-3 mb-4 rounded-xl h-40 focus:border-orange-400 outline-none"></textarea>
            <button onclick="guardarNoticia()" class="w-full bg-azul hover:bg-blue-800 text-white font-bold py-4 rounded-xl shadow-lg transition-colors">
                🚀 PUBLICAR AHORA
            </button>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, query, orderBy } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAUWSoLlaSFXaFMrOv1zdmCmyJEDcQ2YDA",
            authDomain: "web-julian-nieto.firebaseapp.com",
            projectId: "web-julian-nieto",
            storageBucket: "web-julian-nieto.firebasestorage.app",
            messagingSenderId: "1023606619467",
            appId: "1:1023606619467:web:e9b357b114177a72f77cce"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Cargar noticias automáticamente
        async function cargarNoticias() {
            try {
                const q = query(collection(db, "noticias"), orderBy("fecha", "desc"));
                const querySnapshot = await getDocs(q);
                const contenedor = document.getElementById('contenedor-noticias');
                contenedor.innerHTML = '';
                
                if (querySnapshot.empty) {
                    contenedor.innerHTML = '<p class="text-gray-400 col-span-full italic">No hay noticias publicadas todavía.</p>';
                    return;
                }

                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    const fecha = data.fecha ? data.fecha.toDate().toLocaleDateString() : '';
                    contenedor.innerHTML += `
                        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all hover:-translate-y-1">
                            <span class="text-xs font-bold text-orange-500 uppercase tracking-widest">${fecha}</span>
                            <h4 class="font-bold text-2xl my-3 text-azul">${data.titulo}</h4>
                            <p class="text-gray-600 leading-relaxed">${data.texto}</p>
                        </div>
                    `;
                });
            } catch (e) { console.error("Error cargando noticias:", e); }
        }

        // Guardar noticia (Admin)
        window.guardarNoticia = async () => {
            const tit = document.getElementById('titulo-noticia').value;
            const tex = document.getElementById('texto-noticia').value;
            if(!tit || !tex) return alert("Por favor, completa el título y el contenido.");
            
            try {
                await addDoc(collection(db, "noticias"), {
                    titulo: tit,
                    texto: tex,
                    fecha: new Date()
                });
                alert("¡Noticia publicada con éxito!");
                document.getElementById('titulo-noticia').value = '';
                document.getElementById('texto-noticia').value = '';
                toggleAdmin();
                cargarNoticias();
            } catch (e) { alert("Error al publicar: " + e); }
        };

        cargarNoticias();
    </script>

    <script>
        function toggleChat() { document.getElementById('burbuja-chat').classList.toggle('hidden'); }
        function toggleAdmin() { document.getElementById('panel-admin').classList.toggle('hidden'); }
    </script>
</body>
</html>
